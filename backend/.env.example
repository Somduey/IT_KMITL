# Must be exactly the same embedding model that created the JSON files.
EMBEDDING_MODEL=BAAI/bge-m3

# ThaiLLM runs locally from Hugging Face. A CUDA GPU is strongly recommended.
THAILLM_MODEL=ThaiLLM/ThaiLLM-8B
THAILLM_LOAD_IN_4BIT=true
MAX_NEW_TOKENS=300

# Only return an answer when a matching source is found.
MIN_SIMILARITY=0.35
CORS_ORIGINS=http://localhost:5173
